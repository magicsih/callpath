{
  "name": "@callpath/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./names": {
      "types": "./dist/names.d.ts",
      "import": "./dist/names.js"
    }
  },
  "bin": {
    "callpath": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "@tree-sitter-grammars/tree-sitter-kotlin": "^1.1.0",
    "tree-sitter-java": "^0.23.5",
    "web-tree-sitter": "^0.27.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^24.0.0",
    "fast-check": "^4.10.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
