{
  "name": "@callpath/desktop",
  "productName": "Callpath",
  "version": "0.1.2",
  "license": "MIT",
  "private": true,
  "description": "Callpath 데스크톱 앱",
  "main": "./out/main/index.mjs",
  "files": ["out"],
  "scripts": {
    "ensure-electron": "node scripts/ensure-electron.mjs",
    "dev": "node --import ./scripts/ensure-electron.mjs ./node_modules/electron-vite/bin/electron-vite.js dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test"
  },
  "dependencies": {
    "@callpath/core": "workspace:*",
    "@callpath/llm": "workspace:*",
    "@callpath/lsp": "workspace:*",
    "@callpath/providers": "workspace:*"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.1",
    "electron-vite": "6.0.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vitest": "^5.0.0"
  }
}
